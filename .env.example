# Copiar a ms-orchestrator/.env (y NO subirlo a git)
POSTGRES_USER=user
POSTGRES_PASSWORD=password
USERS_DB_NAME=users_db
PAYMENTS_DB_NAME=payments_db
SERVICES_DB_NAME=services_db

# Object storage (RustFS, compatible con API S3 - GC-456)
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_BUCKET=lakehouse
RUSTFS_BUCKET_EVIDENCES=evidences
RUSTFS_IMAGE=rustfs/rustfs:latest
RC_IMAGE=rustfs/rc:latest

# Clave interna para comunicación inter-microservicio (X-Internal-Api-Key)
INTERNAL_API_KEY=

# Claves JWT de ms-users (RS256). Las genera ./generate-keys.sh; si las creas a mano, una línea por clave
# con los saltos de línea escritos como \n (comandos de openssl en el README de ms-users).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
