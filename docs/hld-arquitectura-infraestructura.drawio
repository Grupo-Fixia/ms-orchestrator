        <mxCell id="legend_langs" value="CATÁLOGO OFICIAL Y EXCLUSIVO DE APLICACIONES FIXIA (NO EXISTEN OTROS MICROSERVICIOS):&#xa;1. ms-frontend: Dart 3 / Flutter Web 3.22 + Nginx (Logo: Flutter/Dart)   |   2. ms-users: Java 21 / Spring Boot 3 (Logo: Java + Spring)   |   3. ms-services: Java 21 / Spring Boot 3 (Logo: Java + Spring)&#xa;4. ms-matching-geo: Python 3.12 / FastAPI (Logo: Python + FastAPI)   |   5. ms-payments: C# 12 / .NET 8 ASP.NET Core (Logo: C# / .NET)   |   6. ms-intake-lakehouse: Go (Golang) 1.22 (Logo: Go)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#1e3a8a;fontStyle=1;fontSize=12;align=center;" vertex="1" parent="1">
