apiVersion: apps/v1
kind: Deployment
metadata:
  name: kafka-exporter
  namespace: apps
  labels:
    app: kafka-exporter
    environment: "{{ env | default('qa') }}"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: kafka-exporter
  template:
    metadata:
      labels:
        app: kafka-exporter
        environment: "{{ env | default('qa') }}"
      annotations:
        prometheus.io/scrape: "true"
        prometheus.io/port: "9308"
    spec:
      containers:
        - name: kafka-exporter
          image: danielqsj/kafka-exporter:{{ kafka_exporter_version | default('v1.8.0') }}
          args:
            - --kafka.server={{ kafka_server | default('kafka-0.kafka.data.svc.cluster.local:9092') }}
          ports:
            - name: metrics
              containerPort: 9308
          resources:
            requests:
              cpu: 30m
              memory: 32Mi
            limits:
              cpu: 200m
              memory: 128Mi
          readinessProbe:
            httpGet:
              path: /
              port: metrics
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /
              port: metrics
            initialDelaySeconds: 15
            periodSeconds: 20
---
apiVersion: v1
kind: Service
metadata:
  name: kafka-exporter
  namespace: apps
  labels:
    app: kafka-exporter
    environment: "{{ env | default('qa') }}"
spec:
  type: LoadBalancer
  selector:
    app: kafka-exporter
  ports:
    - name: metrics
      port: 9308
      targetPort: 9308
