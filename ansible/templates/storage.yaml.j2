apiVersion: v1
kind: Namespace
metadata:
  name: data
---
apiVersion: v1
kind: ResourceQuota
metadata:
  name: data-storage-quota
  namespace: data
spec:
  hard:
    requests.storage: 30Gi
    persistentvolumeclaims: "10"
---
apiVersion: v1
kind: LimitRange
metadata:
  name: data-pvc-limits
  namespace: data
spec:
  limits:
    - type: PersistentVolumeClaim
      max:
        storage: 10Gi
      min:
        storage: 500Mi